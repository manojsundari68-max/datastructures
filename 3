//Queue Using Two Stacks in C

#include <stdio.h>

#define MAX 100

int s1[MAX], s2[MAX];
int top1 = -1, top2 = -1;

void push1(int x) {
    s1[++top1] = x;
}

void push2(int x) {
    s2[++top2] = x;
}

int pop1() {
    return s1[top1--];
}

int pop2() {
    return s2[top2--];
}

int isEmpty1() {
    return top1 == -1;
}

int isEmpty2() {
    return top2 == -1;
}

void enqueue(int x) {
    push1(x);
    printf("%d inserted\n", x);
}

void dequeue() {
    if (isEmpty1() && isEmpty2()) {
        printf("Queue Underflow\n");
        return;
    }

    if (isEmpty2()) {
        while (!isEmpty1()) {
            push2(pop1());
        }
    }

    printf("%d deleted\n", pop2());
}

void display() {
    if (isEmpty1() && isEmpty2()) {
        printf("Queue is Empty\n");
        return;
    }

    printf("Queue elements: ");

    for (int i = top2; i >= 0; i--)
        printf("%d ", s2[i]);

    for (int i = 0; i <= top1; i++)
        printf("%d ", s1[i]);

    printf("\n");
}

int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);

    display();

    dequeue();

    display();

    enqueue(40);

    display();

    return 0;
}
