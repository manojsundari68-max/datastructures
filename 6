//"Perform arithmetic operations on a dynamic number of integers",

#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i;
    int *arr;
    int sum = 0, product = 1;

    printf("Enter number of integers: ");
    scanf("%d", &n);

    arr = (int *)malloc(n * sizeof(int));

    if (arr == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }

    printf("Enter %d integers:\n", n);

    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Addition
    for(i = 0; i < n; i++) {
        sum += arr[i];
    }

    // Multiplication
    for(i = 0; i < n; i++) {
        product *= arr[i];
    }

    // Subtraction
    int subtraction = arr[0];
    for(i = 1; i < n; i++) {
        subtraction -= arr[i];
    }

    float average = (float)sum / n;

    printf("\nSum = %d", sum);
    printf("\nSubtraction = %d", subtraction);
    printf("\nProduct = %d", product);
    printf("\nAverage = %.2f", average);

    free(arr);

    return 0;
}
