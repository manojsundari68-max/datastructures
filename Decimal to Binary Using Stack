#include <stdio.h>

int stack[100], top = -1;

void push(int x) {
    stack[++top] = x;
}

int pop() {
    return stack[top--];
}

int main() {
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    while(n > 0) {
        push(n % 2);
        n /= 2;
    }

    printf("Binary: ");
    while(top != -1)
        printf("%d", pop());

    return 0;
}
